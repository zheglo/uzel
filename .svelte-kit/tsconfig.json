{
	"compilerOptions": {
		"paths": {
			"~fonts": ["../src/lib/fonts"],
			"~fonts/*": ["../src/lib/fonts/*"],
			"~components": ["../src/components"],
			"~components/*": ["../src/components/*"],
			"~routes": ["../src/routes"],
			"~routes/*": ["../src/routes/*"],
			"~db": ["../src/server/db"],
			"~db/*": ["../src/server/db/*"],
			"~lib": ["../src/lib"],
			"~lib/*": ["../src/lib/*"],
			"~assets": ["../src/lib/assets"],
			"~assets/*": ["../src/lib/assets/*"],
			"~animations": ["../src/lib/animations"],
			"~animations/*": ["../src/lib/animations/*"],
			"$lib": ["../src/lib"],
			"$lib/*": ["../src/lib/*"],
			"$app/types": ["./types/index.d.ts"]
		},
		"rootDirs": ["..", "./types"],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"target": "esnext"
	},
	"include": [
		"ambient.d.ts",
		"env.d.ts",
		"non-ambient.d.ts",
		"./types/**/$types.d.ts",
		"../vite.config.js",
		"../vite.config.ts",
		"../src/**/*.js",
		"../src/**/*.ts",
		"../src/**/*.svelte",
		"../test/**/*.js",
		"../test/**/*.ts",
		"../test/**/*.svelte",
		"../tests/**/*.js",
		"../tests/**/*.ts",
		"../tests/**/*.svelte",
		"../drizzle.config.ts"
	],
	"exclude": [
		"../node_modules/**",
		"../src/service-worker.js",
		"../src/service-worker/**/*.js",
		"../src/service-worker.ts",
		"../src/service-worker/**/*.ts",
		"../src/service-worker.d.ts",
		"../src/service-worker/**/*.d.ts"
	]
}
