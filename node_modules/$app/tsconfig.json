{
	"compilerOptions": {
		"paths": {
			"~fonts": [
				"../../src/lib/fonts"
			],
			"~fonts/*": [
				"../../src/lib/fonts/*"
			],
			"~components": [
				"../../src/components"
			],
			"~components/*": [
				"../../src/components/*"
			],
			"~routes": [
				"../../src/routes"
			],
			"~routes/*": [
				"../../src/routes/*"
			],
			"~db": [
				"../../src/server/db"
			],
			"~db/*": [
				"../../src/server/db/*"
			],
			"~lib": [
				"../../src/lib"
			],
			"~lib/*": [
				"../../src/lib/*"
			],
			"~assets": [
				"../../src/lib/assets"
			],
			"~assets/*": [
				"../../src/lib/assets/*"
			],
			"~animations": [
				"../../src/lib/animations"
			],
			"~animations/*": [
				"../../src/lib/animations/*"
			],
			"~motion": [
				"../../src/lib/motion"
			],
			"~motion/*": [
				"../../src/lib/motion/*"
			]
		},
		"rootDirs": [
			"../..",
			"../../.svelte-kit/types"
		],
		"types": [
			"$app/types"
		],
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"module": "esnext",
		"target": "esnext",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noEmit": true
	}
}